    if (this.rewardGranted) {
      return 'å…è´¹è”ç³»';
    }
    if (this.rewardCountdown > 0) {
      return `è§‚çœ‹ä¸­ (${this.rewardCountdown}s)`;
    }
    if (this.adLoading) {
