    this.statusBarHeight = (AppStorage.get<number>('statusBarHeight') ?? 0);
    this.navBarHeight = (AppStorage.get<number>('navBarHeight') ?? 0);
    // åˆè§„ï¼šé¦–æ¬¡å¯åŠ¨å¿…é¡»å…ˆè·å¾—éšç§åè®®åŒæ„ï¼ŒåŒæ„åæ‰è¯·æ±‚æ•°æ®ä¸å¹¿å‘Š
    if (Store.getBool('privacy_agreed', false)) {
      this.loadList(true, true);
    } else {
      this.showPrivacyDialog();
    }
  }

  /** é¦–å¯éšç§åè®®å¼¹çª—ï¼ˆå¹¿å‘Šåˆè§„ç¡¬æ€§è¦æ±‚ï¼šåŒæ„å‰ä¸å¾—è¯·æ±‚å¹¿å‘Šï¼‰ */
  private showPrivacyDialog(): void {
    this.getUIContext().getPromptAction().showDialog({
      title: 'ç”¨æˆ·åè®®ä¸éšç§æ”¿ç­–',
      message: 'æ„Ÿè°¢æ‚¨ä½¿ç”¨å·¥èœ‚æ‹›å·¥æ‰¾æ´»å¹³å°ã€‚æˆ‘ä»¬å°†ä¸¥æ ¼éµå®ˆæ³•å¾‹æ³•è§„ï¼Œä¿æŠ¤æ‚¨çš„ä¸ªäººä¿¡æ¯å®‰å…¨ã€‚' +
        'æˆ‘ä»¬ä¼šåŸºäºç½‘ç»œçŠ¶æ€åŠ è½½æ‹›è˜ä¿¡æ¯ï¼Œå¹¶åœ¨æ‚¨åŒæ„åå±•ç¤ºå¹¿å‘Šå†…å®¹ã€‚è¯·æ‚¨ä»”ç»†é˜…è¯»å¹¶åŒæ„ã€Šç”¨æˆ·åè®®ã€‹å’Œã€Šéšç§æ”¿ç­–ã€‹åç»§ç»­ä½¿ç”¨ã€‚',
      buttons: [
        { text: 'åŒæ„', color: Colors.PRIMARY_TEXT },
        { text: 'ä¸åŒæ„', color: Colors.SECONDARY_TEXT }
      ]
    }).then((result) => {
      if (result.index === 0) {
        Store.putBool('privacy_agreed', true);
        this.initAfterConsent();
      } else {
        // ä¸åŒæ„åˆ™é€€å‡ºï¼ˆè¡Œä¸šé€šè¡Œåˆè§„åšæ³•ï¼‰
        (getContext(this) as common.UIAbilityContext).terminateSelf();
      }
    });
  }

  private async initAfterConsent(): Promise<void> {
    // æ³¨ï¼šå…ƒæœåŠ¡ä¸æ”¯æŒ OAIDï¼ˆidentifier è¢«ç¦ç”¨ï¼‰ï¼Œæ— éœ€å¹¿å‘Šæƒé™åˆå§‹åŒ–ï¼Œä»…éä¸ªæ€§åŒ–å¹¿å‘Š
    this.loadList(true, true);
  }

  private async loadList(refresh: boolean, replace: boolean): Promise<void> {
    if (this.loading) {
      return;
    }
    this.loading = true;
    try {
      const res = await TopicApi.list(this.page, 1, 0);
      if (res.code === 200 && res.data) {
        const topics: Topic[] = res.data.data ?? [];
        this.pageTotal = res.data.last_page ?? -1;

        const rows: ListRow[] = topics.map((t: Topic) => {
          const r = new ListRow();
          r.kind = 0;
          r.topic = t;
          return r;
        });

        // ä¿¡æ¯æµå¹¿å‘Šï¼šæ¯æ‰¹è¯·æ±‚ 1 æ¡æ–°å¹¿å‘Šæ’å…¥ï¼ˆåˆè§„ï¼šä¸é‡å¤å±•ç¤ºåŒä¸€å¹¿å‘Šï¼‰
        if (AdIds.AD_ENABLED && rows.length > 0) {
          const ads = await AdService.loadNativeAds(getContext(this), AdIds.nativeAdId(), 1);
          if (ads.length > 0) {
            const adRow = new ListRow();
            adRow.kind = 1;
            adRow.ad = ads[0];
            rows.splice(Math.min(AD_INSERT_POS, rows.length), 0, adRow);
          }
        }

        if (replace) {
          this.dataSource.replaceAll(rows);
        } else {
          this.dataSource.append(rows);
        }
      } else {
        this.getUIContext().getPromptAction().showToast({ message: res.msg ?? 'åŠ è½½å¤±è´¥' });
      }
    } finally {
      this.loading = false;
      if (refresh) {
        this.refreshing = false;
      }
    }
  }

  private onRefresh(): void {
    this.page = 1;
    this.loadList(true, true);
  }

  private onReachEnd(): void {
    if (!this.loading && this.pageTotal > 0 && this.page < this.pageTotal) {
      this.page += 1;
      this.loadList(false, false);
    }
  }

  /** ä¸€çº§æ ‡é¢˜æ ï¼šä»… 1 ä¸ªæ–‡å­—å…ƒç´ ï¼Œé«˜åº¦ â‰¥44vpï¼Œå­—å· â‰¥20fp åŠ ç²—ï¼Œå³ä¾§ç•™å‡ºèƒ¶å›Šå ä½ */
  @Builder
  titleBar() {
    Row() {
      // å·¦ä¾§ä¸å³ä¾§å ä½ç­‰å®½ï¼Œä½¿æ ‡é¢˜åœ¨è§†è§‰ä¸­å¿ƒä¸èƒ¶å›Šæ°´å¹³ä¸­å¿ƒå¯¹é½
      Blank()
        .width(CAPSULE_MARGIN_RIGHT)
      Text('å·¥èœ‚æ‹›å·¥æ‰¾æ´»å¹³å°')
        .fontSize(20)
        .fontWeight(FontWeight.Bold)
        .fontColor(Colors.BODY_TEXT)
        .textAlign(TextAlign.Center)
        .layoutWeight(1)
      Blank()
        .width(CAPSULE_MARGIN_RIGHT)
    }
    .width('100%')
    .height(this.statusBarHeight + 44)
    .padding({ top: this.statusBarHeight })
    .backgroundColor(Colors.TITLE_BAR_BG)
  }

  @Builder
  filterBar() {
    // åŸæ ‡é¢˜æ ä¸­çš„"å…¨å›½"+tabs å›¾ä¸‹ç§»åˆ°å†…å®¹åŒºï¼Œé¿å…å ç”¨èƒ¶å›ŠåŒºåŸŸ
    Stack() {
      Row() {
        Text(this.address)
          .fontSize(12)
          .fontColor(Colors.BODY_TEXT)
          .margin({ left: 10 })
      }
      .width('100%')

      Row() {
        Image($r('app.media.zzrz'))
          .width('100%')
          .height('100%')
      }
      .width(177)
      .height(24)
      .backgroundColor(Color.White)
      .borderRadius(12)
    }
    .alignContent(Alignment.Center)
    .width('100%')
    .height(36)
    .padding({ left: 20, right: 20 })
    .backgroundColor(Colors.TITLE_BAR_BG)
  }

  @Builder
  emptyView() {
    Column() {
      Image($r('app.media.empty'))
        .width(130)
        .height(130)
        .margin({ bottom: 10 })
      Text('æš‚æ— æ•°æ®')
        .fontSize(14)
        .fontColor(Colors.BODY_TEXT)
    }
    .width('100%')
    .height(400)
    .justifyContent(FlexAlign.Center)
  }

  build() {
    Column() {
      this.titleBar()
      this.filterBar()

      if (this.dataSource.isEmpty() && !this.loading) {
        this.emptyView()
      } else {
        Refresh({ refreshing: $$this.refreshing }) {
          List() {
            LazyForEach(this.dataSource, (item: ListRow, index: number) => {
              ListItem() {
                if (item.kind === 0) {
                  TopicCard({
                    topic: item.topic,
                    onContact: (mobile: string) => {
                      Dialer.dial(this.getUIContext(), mobile);
                    }
                  })
                    .onClick(() => {
                      const id = item.topic?.id;
                      if (id) {
                        router.pushUrl({ url: 'pages/TopicDetailPage', params: { id: id } });
                      }
                    })
                } else {
                  NativeAdCard({ ad: item.ad })
                }
              }
            }, (item: ListRow, index: number) => `${item.kind}_${index}_${item.topic?.id ?? 'ad'}`)
          }
          .width('100%')
          // å®¡æ ¸æ•´æ”¹ï¼šåº•éƒ¨ padding é¿è®©å¯¼èˆªæ¡ï¼Œæ»šåŠ¨åˆ°åº•éƒ¨æ—¶æœ€åä¸€æ¡å¡ç‰‡ä¸è¢«é®æŒ¡
          .padding({ left: 20, right: 20, bottom: this.navBarHeight })
          .onReachEnd(() => this.onReachEnd())
        }
        .onRefreshing(() => this.onRefresh())
        .layoutWeight(1)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor(Colors.PAGE_BG)
  }
}
