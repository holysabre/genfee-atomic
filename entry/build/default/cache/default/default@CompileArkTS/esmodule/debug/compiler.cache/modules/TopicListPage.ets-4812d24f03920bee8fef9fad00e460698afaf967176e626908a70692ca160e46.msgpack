          return r;
        });

        // ä¿¡æ¯æµå¹¿å‘Šï¼šæ¯æ‰¹è¯·æ±‚ 1 æ¡æ–°å¹¿å‘Šæ’å…¥ï¼ˆåˆè§„ï¼šä¸é‡å¤å±•ç¤ºåŒä¸€å¹¿å‘Šï¼‰
        if (AdIds.AD_ENABLED && rows.length > 0) {
          const ads = await AdService.loadNativeAds(getContext(this), AdIds.nativeAdId(), 1);
          if (ads.length > 0) {
            const adRow = new ListRow();
            adRow.kind = 1;
            adRow.ad = ads[0];
            rows.splice(Math.min(AD_INSERT_POS, rows.length), 0, adRow);
          }
        }

        if (replace) {
          this.dataSource.replaceAll(rows);
        } else {
          this.dataSource.append(rows);
        }
      } else {
        this.getUIContext().getPromptAction().showToast({ message: res.msg ?? 'åŠ è½½å¤±è´¥' });
      }
    } finally {
      this.loading = false;
      if (refresh) {
        this.refreshing = false;
      }
    }
  }

  private onRefresh(): void {
    this.page = 1;
    this.loadList(true, true);
  }

  private onReachEnd(): void {
    if (!this.loading && this.pageTotal > 0 && this.page < this.pageTotal) {
      this.page += 1;
      this.loadList(false, false);
    }
  }

  @Builder
  headerBar() {
    Column() {
      // logo + æ ‡é¢˜ï¼ˆè¿˜åŸå°ç¨‹åºè‡ªå®šä¹‰å¯¼èˆªæ ï¼‰
      Row() {
        Image($r('app.media.avatar'))
          .width(30)
          .height(30)
          .borderRadius(15)
          .margin({ right: 8 })
        Text('å·¥èœ‚æ‹›å·¥æ‰¾æ´»å¹³å°')
          .fontSize(14)
          .fontWeight(FontWeight.Bold)
          .fontColor('#222222')
      }
      .width('100%')
      .height(38)
      .padding({ left: 10, right: 10 })

      // åœ°åŒºï¼ˆé™æ€"å…¨å›½"ï¼‰+ ä¸­éƒ¨ tabs å›¾
      Stack() {
        Row() {
          Text(this.address)
            .fontSize(12)
            .fontColor('#222222')
            .margin({ left: 10 })
        }
        .width('100%')

        Row() {
          Image($r('app.media.zzrz'))
            .width('100%')
            .height('100%')
        }
        .width(177)
        .height(24)
        .backgroundColor(Color.White)
        .borderRadius(12)
      }
      .alignContent(Alignment.Center)
      .width('100%')
      .height(36)
    }
    .width('100%')
    .padding({ top: this.statusBarHeight })
    .backgroundColor('#B0CBEB')
  }

  @Builder
  emptyView() {
    Column() {
      Image($r('app.media.empty'))
        .width(130)
        .height(130)
        .margin({ bottom: 10 })
      Text('æš‚æ— æ•°æ®')
        .fontSize(14)
        .fontColor('#333333')
    }
    .width('100%')
    .height(400)
    .justifyContent(FlexAlign.Center)
  }

  build() {
    Column() {
      this.headerBar()

      if (this.dataSource.isEmpty() && !this.loading) {
        this.emptyView()
      } else {
        Refresh({ refreshing: $$this.refreshing }) {
          List() {
            LazyForEach(this.dataSource, (item: ListRow, index: number) => {
              ListItem() {
                if (item.kind === 0) {
                  TopicCard({
                    topic: item.topic,
                    onContact: (mobile: string) => {
                      Dialer.dial(this.getUIContext(), mobile);
                    }
                  })
                    .onClick(() => {
                      const id = item.topic?.id;
                      if (id) {
                        router.pushUrl({ url: 'pages/TopicDetailPage', params: { id: id } });
                      }
                    })
                } else {
                  NativeAdCard({ ad: item.ad })
                }
              }
            }, (item: ListRow, index: number) => `${item.kind}_${index}_${item.topic?.id ?? 'ad'}`)
          }
          .width('100%')
          .padding({ left: 20, right: 20 })
          .onReachEnd(() => this.onReachEnd())
        }
        .onRefreshing(() => this.onRefresh())
        .layoutWeight(1)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#B0CBEB')
  }
}
