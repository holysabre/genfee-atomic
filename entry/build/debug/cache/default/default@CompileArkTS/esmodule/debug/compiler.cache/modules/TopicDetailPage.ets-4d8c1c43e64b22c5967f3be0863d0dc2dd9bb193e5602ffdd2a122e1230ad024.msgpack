  @State private navBarHeight: number = 0; // åº•éƒ¨å¯¼èˆªæ¡é¿è®©é«˜åº¦ï¼ˆå®¡æ ¸æ•´æ”¹ï¼‰
  @State private rewardGranted: boolean = false; // æ¿€åŠ±è§†é¢‘æ˜¯å¦å·²çœ‹å®Œ
  @State private adLoading: boolean = false; // å¹¿å‘ŠåŠ è½½ä¸­çŠ¶æ€

  private rewardAd: advertising.Advertisement | null = null;

  aboutToAppear(): void {
    this.statusBarHeight = (AppStorage.get<number>('statusBarHeight') ?? 0);
    this.navBarHeight = (AppStorage.get<number>('navBarHeight') ?? 0);
    const params = router.getParams() as Record<string, number> | undefined;
    const id = params?.id ?? 0;
    if (id > 0) {
      this.loadDetail(id);
    }
    // åˆè§„ï¼šè¯·æ±‚/å±•ç¤ºå¹¿å‘Šå‰å¿…é¡»å·²è·å¾—éšç§åè®®åŒæ„ï¼ˆé¡µé¢å±‚å·²æ§åˆ¶ï¼ŒaboutToAppear æ—¶åŒæ„æ€å·²ç¡®å®šï¼‰
    this.tryShowInterstitial();
  }

  private async loadDetail(id: number): Promise<void> {
    const res = await TopicApi.detail(id);
    if (res.code === 200 && res.data?.data) {
      this.info = res.data.data;
      this.tags = (this.info.category_name ?? '').split('ã€').filter((s: string) => s.length > 0);
    } else {
      this.getUIContext().getPromptAction().showToast({ message: res.msg ?? 'åŠ è½½å¤±è´¥' });
    }
  }

  /** åº”ç”¨ç”Ÿå‘½å‘¨æœŸå†…æœ€å¤šå±•ç¤º 1 æ¬¡æ’å±å¹¿å‘Š */
  private async tryShowInterstitial(): Promise<void> {
    if (!AdIds.AD_ENABLED) {
      return;
    }
    const alreadyShown = AppStorage.get<boolean>(INTERSTITIAL_SHOWN_KEY) ?? false;
    if (alreadyShown) {
      return;
    }
    const ad = await AdService.loadInterstitialAd(
      getContext(this),
      AdIds.interstitialVideoAdId(),
      AdIds.interstitialImageAdId()
    );
    if (ad !== null) {
      AppStorage.setOrCreate(INTERSTITIAL_SHOWN_KEY, true);
      AdService.showInterstitialAd(getContext(this) as common.UIAbilityContext, ad);
    }
  }

  /** ç‚¹å‡»å…è´¹è”ç³»ï¼šæœªçœ‹æ¿€åŠ±è§†é¢‘åˆ™å…ˆåŠ è½½å¹¶æ’­æ”¾ï¼Œçœ‹å®Œæ‰èƒ½æ‹¨å· */
  private async onContactClick(): Promise<void> {
    if (this.rewardGranted) {
      this.doDial();
      return;
    }
    if (this.adLoading) {
      return;
    }
    if (!AdIds.AD_ENABLED) {
      // å¹¿å‘Šæ€»å¼€å…³å…³é—­æ—¶ç›´æ¥å…è®¸è”ç³»
      this.doDial();
      return;
    }

    this.adLoading = true;
    try {
      const ad = await AdService.loadRewardAd(getContext(this), AdIds.rewardAdId());
      if (ad === null) {
        this.getUIContext().getPromptAction().showToast({ message: 'å¹¿å‘ŠåŠ è½½å¤±è´¥ï¼Œè¯·ç¨åé‡è¯•' });
        return;
      }
      this.rewardAd = ad;
      AdService.showRewardAd(getContext(this) as common.UIAbilityContext, ad, {
        onReward: () => {
          this.rewardGranted = true;
          this.getUIContext().getPromptAction().showToast({ message: 'å·²è·å¾—å…è´¹è”ç³»æƒé™' });
        },
        onClose: () => {
          if (this.rewardGranted) {
            this.doDial();
          }
        },
        onError: (code: number, msg: string) => {
          hilog.error(0x0000, 'WorkerBeeAd', 'reward show error code=%{public}d msg=%{public}s', code, msg);
          this.getUIContext().getPromptAction().showToast({ message: 'å¹¿å‘Šæ’­æ”¾å¤±è´¥ï¼Œè¯·ç¨åé‡è¯•' });
        }
      });
    } finally {
      this.adLoading = false;
    }
  }

  private doDial(): void {
    const mobile = this.info?.mobile;
    if (mobile !== undefined && mobile !== null) {
      Dialer.dial(this.getUIContext(), String(mobile));
    }
  }

  /** äºŒçº§æ ‡é¢˜æ ï¼šè¿”å›å›¾ç‰‡ + æ ‡é¢˜ï¼Œå…± 2 ä¸ªå…ƒç´ ï¼›å³ä¾§ç•™å‡ºèƒ¶å›Šå ä½ */
  @Builder
  titleBar() {
    Row() {
      Row() {
        Image($r('app.media.back'))
          .width(24)
          .height(24)
          .onClick(() => {
            router.back();
          })
      }
      .width(CAPSULE_MARGIN_RIGHT)
      .justifyContent(FlexAlign.Start)

      Text('å†…å®¹è¯¦æƒ…')
        .fontSize(20)
        .fontWeight(FontWeight.Bold)
        .fontColor('#222222')
        .textAlign(TextAlign.Center)
        .layoutWeight(1)

      Blank()
        .width(CAPSULE_MARGIN_RIGHT)
    }
    .width('100%')
    .height(this.statusBarHeight + 44)
    .padding({ top: this.statusBarHeight })
    .backgroundColor(Color.White)
  }

  @Builder
  labelRow(label: string, value: string, valueColor: string, bold: boolean) {
    Row() {
      Text(label)
        .fontSize(14)
        .fontColor('#595959')
      Text(value)
        .fontSize(14)
        .fontColor(valueColor)
        .fontWeight(bold ? FontWeight.Bold : FontWeight.Regular)
    }
    .width('100%')
    .justifyContent(FlexAlign.SpaceBetween)
    .margin({ bottom: 10 })
  }

  build() {
    Column() {
      this.titleBar()

      Stack({ alignContent: Alignment.Bottom }) {
        // å†…å®¹åŒº
        Scroll() {
          Column() {
            // éœ€æ±‚èŒä¸šæ ‡ç­¾
            Row() {
              Text('éœ€æ±‚èŒä¸šï¼š')
                .fontSize(14)
                .fontColor('#595959')
              Flex({ wrap: FlexWrap.Wrap }) {
                ForEach(this.tags, (tag: string) => {
                  Text(tag)
                    .fontSize(13)
                    .fontColor('#A67C00')
                    .height(20)
                    .padding({ left: 12, right: 12 })
                    .borderRadius(13)
                    .border({ width: 1, color: '#A67C00' })
                    .margin({ right: 10, bottom: 10 })
                })
              }
              .layoutWeight(1)
            }
            .width('100%')
            .alignItems(VerticalAlign.Top)
            .margin({ bottom: 10 })

            // è¦æ±‚ + å‘å¸ƒæ—¶é—´ + å†…å®¹ + åœ°å€
            Column() {
              Row() {
                Text('è¦æ±‚ï¼š')
                  .fontSize(14)
                  .fontColor('#595959')
                Text(`å‘å¸ƒæ—¶é—´ï¼š${this.info?.created_at ?? 'æš‚æ— '}`)
                  .fontSize(12)
                  .fontColor('#595959')
              }
              .width('100%')
              .justifyContent(FlexAlign.SpaceBetween)

              Text(this.info?.content ?? '')
                .fontSize(14)
                .fontColor('#222222')
                .lineHeight(24)
                .width('100%')
                .margin({ top: 8, bottom: 10 })

              Row() {
                Image($r('app.media.address2'))
                  .width(12)
                  .height(12)
                  .margin({ right: 4 })
                Text(this.info?.address ?? '')
                  .fontSize(14)
                  .fontColor('#595959')
              }
              .width('100%')
            }
            .width('100%')
            .margin({ bottom: 10 })

            // party != 2ï¼ˆæ‹›å·¥ï¼‰æ‰å±•ç¤ºè–ªé…¬/ä¼ä¸š/æ”¶è´¹è¯´æ˜
            if ((this.info?.party ?? 1) !== 2) {
              this.labelRow('è–ªé…¬èŒƒå›´ï¼š', this.info?.salary ?? 'æš‚æ— ', '#A67C00', true)
              this.labelRow('ä¼ä¸šå•ä½ï¼š', this.info?.company_name ?? 'æš‚æ— ', '#222222', false)
              this.labelRow('å²—ä½æ”¶è´¹è¦æ±‚ï¼š', 'è¯¥å²—ä½æ‹›è˜ä¸æ¶‰åŠæ”¶è´¹', '#222222', false)
            }
          }
          .width('100%')
          // å®¡æ ¸æ•´æ”¹ï¼šå†…å®¹åŒºåº•éƒ¨ç•™ç™½ = å›ºå®šæ“ä½œåŒºé«˜åº¦ + å¯¼èˆªæ¡é«˜åº¦ï¼Œæ»šåˆ°åº•ä¸è¢«é®æŒ¡
          .padding({ left: 16, right: 16, top: 14, bottom: 150 + this.navBarHeight })
        }
        .width('100%')
        .height('100%')

        // åº•éƒ¨å›ºå®šæ“ä½œåŒºï¼ˆæ¸©é¦¨æç¤º + Banner å¹¿å‘Š + å…è´¹è”ç³»ï¼‰
        Column() {
          Row() {
            Image($r('app.media.warn'))
              .width(24)
              .height(24)
            Text('æ¸©é¦¨æç¤º')
              .fontSize(12)
              .fontColor('#A67C00')
          }
          .margin({ bottom: 3 })

          Text('è”ç³»ä¹‹å‰è¯·æ‚¨æ³¨æ„è¾¨åˆ«ä¿¡æ¯çœŸä¼ªï¼Œæ ¸å®å²—ä½å®æƒ…åŠå®é™…æƒ…å†µï¼Œè°¨é˜²ä¸Šå½“å—éª—ã€‚å¹³å°ä¸å‚ä¸æ‹›è˜äº‹å®œï¼Œç›¸å…³æ‹›è˜åŠå±¥çº¦é—®é¢˜ç”±æ‹›è˜åŒæ–¹ç¡®è®¤å¹¶æ‹…è´£ã€‚')
            .fontSize(10)
            .fontColor('#666666')
            .width('100%')
            .margin({ bottom: 10 })

          if (AdIds.AD_ENABLED) {
            BannerAdView()
              .margin({ bottom: 8 })
          }

          Text(this.rewardGranted ? 'å…è´¹è”ç³»' : (this.adLoading ? 'å¹¿å‘ŠåŠ è½½ä¸­...' : 'è§‚çœ‹è§†é¢‘åå…è´¹è”ç³»'))
            .fontSize(15)
            .fontColor('#000000')
            .textAlign(TextAlign.Center)
            .width('100%')
            .height(44)
            .backgroundColor('#FDD000')
            .borderRadius(8)
            .onClick(() => this.onContactClick())
        }
        .width('100%')
        // å®¡æ ¸æ•´æ”¹ï¼šåº•éƒ¨å›ºå®šåŒºæ•´ä½“æŠ¬é«˜é¿è®©å¯¼èˆªæ¡ï¼Œç™½è‰²èƒŒæ™¯å»¶ä¼¸è¿›å¯¼èˆªæ¡åŒºåŸŸå½¢æˆæ²‰æµ¸èåˆ
        .padding({ left: 17, right: 17, top: 10, bottom: 15 + this.navBarHeight })
        .backgroundColor(Color.White)
      }
      .width('100%')
      .layoutWeight(1)
      .backgroundColor(Color.White)
    }
    .width('100%')
    .height('100%')
    .backgroundColor(Color.White)
  }
}
